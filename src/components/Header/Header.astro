---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../../const";
import "./header.scss";

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const currentPath = Astro.url.pathname.split("/").slice(2).join("/");
const wtcPath = locale === "en-us" ? "/wtc/" : `/${locale}/wtc/`;
---

<header>
  
  <nav class="nav">
    <a href="/">Home</a>
    <a href={wtcPath}>WTC</a>
    <label>
      Language Selector
      <select>
        {locales.map((availableLocale) => (
          <option
            value={getRelativeLocaleUrl(availableLocale, currentPath)}
            selected={availableLocale === locale}
          >
            {availableLocale}
          </option>
        ))}
      </select>
    </label>
  </nav>
</header>

<script>
  const localeSelector = document.querySelector("select");

  localeSelector?.addEventListener("change", (event) => {
    const select = event.currentTarget as HTMLSelectElement;
    window.location.href = select.value;
  });
</script>
