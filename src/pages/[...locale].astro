---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Picture from "../components/Picture/Picture.astro";
import { locales } from "../const";

export async function getStaticPaths() {
  const homeContents = await getCollection("home");

  return locales.map((locale) => {
    const page = homeContents.find((entry) => entry.id.split("/").at(-1) === locale);

    if (!page) {
      throw new Error(`Missing home content for locale: ${locale}`);
    }

    return {
      params: { locale: locale === "en-us" ? undefined : locale },
      props: { locale, page },
    };
  });
}

const { locale, page } = Astro.props;
const { data } = page;
---

<Layout title={data.siteName} locale={locale}>
  <h1>{data.heading}</h1>
  {data.description ? <p>{data.description}</p> : null}
  {data.images.map((image) => (
    <Picture src={image.src} alt={image.alt} />
  ))}
</Layout>
