---
import { getCollection } from "astro:content";
import WtcPage from "../../../components/WtcPage.astro";
import { locales } from "../../../const";

export async function getStaticPaths() {
  const wtcContents = await getCollection("wtc");

  return locales
    .filter((locale) => locale !== "en-us")
    .flatMap((locale) => {
      const page = wtcContents.find((entry) => entry.id.split("/").at(-1) === locale);

      if (!page) {
        return [];
      }

      return [{ params: { locale }, props: { page } }];
    });
}

const locale = Astro.params.locale;
if (!locale) {
  throw new Error("Missing locale for localized WTC page");
}
---

<WtcPage locale={locale} page={Astro.props.page} />
