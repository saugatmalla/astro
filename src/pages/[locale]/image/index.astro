---
import Layout from "../../../layouts/Layout.astro";
import { getRelativeLocaleUrlList } from "astro:i18n";

import Picture from "../../../components/Picture/Picture.astro"

import "./my-image.scss"

export async function getStaticPaths() {
  // Use Astro's i18n utility to get a list of locale-specific paths
  const paths = getRelativeLocaleUrlList();

  // Transform the paths into the format required by Astro
  return paths.map((url) => {
    // Extract the locale from the path. This assumes every locale has a prefix.
    const locale = url.split("/")[1];

    // Return an object with the locale as a route parameter for Astro to generate the page
    return { params: { locale } };
  });
}

const locale = Astro.params.locale;
---

<Layout>
  <h1>Images</h1>

  <div class="grid">
    <figure>
      <Picture src={"/src/assets/stock-images/stock-image-1.jpg"} alt="" class="my-picture"/>
      <caption>caption 1</caption>
    </figure>
    <figure>
      <Picture src={"/src/assets/stock-images/stock-image-2.jpg"} alt="" class="my-picture"/>
      <caption>caption 2</caption>
    </figure>
    <figure>
      <Picture src={"/src/assets/stock-images/stock-image-3.jpg"} alt="" class="my-picture"/>
      <caption>caption 3</caption>
    </figure>
   
  </div>
</Layout>
